# Bypass Paywalls Clean Configuration for Qutebrowser
# Add this to your ~/.config/qutebrowser/config.py

# Load autoconfig (load settings configured via GUI)
config.load_autoconfig()

import os
from pathlib import Path

# Get config directory
config_dir = Path(config.configdir)
bypass_paywall_dir = config_dir / "bypass-paywalls"

# Enable content blocking
c.content.blocking.enabled = True

# Set blocking method (best compatibility)
c.content.blocking.method = "both"

# Add Bypass Paywalls Clean filters
bypass_filter_path = bypass_paywall_dir / "bpc-paywall-filter.txt"

# ═══════════════════════════════════════════════════════════════
# FILTER LISTS - Choose your level:
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# OPTION 1: BALANCED (Recommended - ~150K filters)
# Good performance, blocks paywalls + ads + trackers + cookie notices
# ──────────────────────────────────────────────────────────────
if bypass_filter_path.exists():
    config.set('content.blocking.adblock.lists', [
        # ★ PAYWALL BYPASS (Priority #1)
        str(bypass_filter_path.as_uri()),

        # ★ ADS (Essential)
        "https://easylist.to/easylist/easylist.txt",  # ~83K filters

        # ★ PRIVACY & TRACKING (Essential)
        "https://easylist.to/easylist/easyprivacy.txt",  # ~27K filters
        "https://secure.fanboy.co.nz/enhancedstats.txt",  # Fanboy's Enhanced Tracking (recommended with BPC)

        # ★ COOKIE NOTICES (Highly recommended for news sites)
        "https://secure.fanboy.co.nz/fanboy-cookiemonster.txt",  # ~35K filters

        # ★ ANNOYANCES (Recommended - removes popups, newsletters, social widgets)
        "https://easylist.to/easylist/fanboy-annoyance.txt",  # ~18K filters
    ])
    print(f"✓ Loaded Bypass Paywalls Clean filters (Balanced mode)")
else:
    print(f"⚠ Bypass Paywalls Clean filters not found at {bypass_filter_path}")
    print("  Run: ~/.config/qutebrowser/bypass-paywalls/update-filters.sh")

# ──────────────────────────────────────────────────────────────
# OPTION 2: AGGRESSIVE (More blocking - ~300K+ filters)
# Better blocking but may break some sites. Uncomment to use:

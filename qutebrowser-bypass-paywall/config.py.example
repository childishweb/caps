#     print(f"✓ Loaded Bypass Paywalls Clean filters (Aggressive mode)")

# ──────────────────────────────────────────────────────────────
# OPTION 3: MINIMAL (Fastest - ~100K filters)
# Only paywall bypass + basic ad/tracking blocking. Uncomment to use:
# ──────────────────────────────────────────────────────────────
# if bypass_filter_path.exists():
#     config.set('content.blocking.adblock.lists', [
#         str(bypass_filter_path.as_uri()),  # Bypass Paywalls Clean

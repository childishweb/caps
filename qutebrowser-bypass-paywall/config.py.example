#         "https://easylist.to/easylist/easyprivacy.txt",  # Basic privacy
#     ])
#     print(f"✓ Loaded Bypass Paywalls Clean filters (Minimal mode)")

# Enable JavaScript (required for many sites)
c.content.javascript.enabled = True

# Optional: Configure user agent to avoid some paywalls
# Uncomment if needed:
# c.content.headers.user_agent = (
#     "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
#     "AppleWebKit/537.36 (KHTML, like Gecko) "
#     "Chrome/120.0.0.0 Safari/537.36"
# )

# Optional: Clear cookies on shutdown for paywall sites
# This helps bypass some cookie-based paywalls
# c.content.cookies.store = False  # Uncomment for strict mode

# Optional: Disable referrer for better privacy and paywall bypass
# c.content.headers.referer = "never"  # Uncomment if needed

# Additional recommended settings for paywall bypass
c.content.blocking.whitelist = []  # Add any sites you want to support here

# Auto-reload filters on startup
config.bind('<Ctrl-Shift-r>', 'adblock-update')

print("═" * 60)
print("  Bypass Paywalls Clean for Qutebrowser - Loaded")
print("═" * 60)
print("")
print("  Commands:")
print("    :adblock-update        - Reload adblock filters")
print("    Ctrl+Shift+R          - Quick reload filters")
print("")
print("  Update filters:")
print(f"    {bypass_paywall_dir}/update-filters.sh")
print("")
